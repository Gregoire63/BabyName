# Pour essai-apple.mjs (l'achat dans l'app iOS). Aucune de ces valeurs n'ouvre
# quoi que ce soit : elles n'existent ni chez Apple ni chez Stripe.
# Un faux Apple, sur la machine : la production, puis le bac à sable.
NUXT_APPLE_IAP_API=http://127.0.0.1:3197/prod
NUXT_APPLE_IAP_API_BAC=http://127.0.0.1:3197/bac
# Une clé tirée au hasard pour cet essai, et pour lui seul : elle ne signe que
# des demandes adressées au faux Apple, qui vérifie la signature avec elle.
NUXT_APPLE_IAP_CLE=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQggGJWDxTGot/SHtPqfVJ9OvfWrFqwx6VFZp3CuYRjBzGhRANCAATt0o6iT7GjJGhADF/fQEyZ17Zo2j8YyzT1UlYZ+OKRO0MNKKbQHoGe6ZHWw2H4+msAR7UU4wB52p31LWUVxlw9
NUXT_APPLE_IAP_CLE_ID=CLEESSAI01
NUXT_APPLE_IAP_EMETTEUR=11111111-2222-4333-8444-555555555555
# Un faux service d'envoi de notifications : l'autre parent apprend le déblocage.
NUXT_PUSH_URL=http://127.0.0.1:3198/push
# Le faux Stripe d'essai-caisse : pour voir les deux caisses se croiser.
NUXT_STRIPE_SECRET_KEY=sk_test_essai_local
NUXT_STRIPE_PRICE_ID=price_essai_local
NUXT_STRIPE_WEBHOOK_SECRET=whsec_essai_local
NUXT_STRIPE_API_BASE=http://127.0.0.1:3199/v1
