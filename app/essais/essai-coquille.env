# Pour essai-coquille.mjs (les apps des stores). Aucune de ces valeurs n'ouvre
# quoi que ce soit : elles n'existent ni chez Expo, ni chez Apple, ni chez
# Google, ni chez Stripe.
# Un faux service d'envoi de notifications, sur la machine.
NUXT_PUSH_URL=http://127.0.0.1:3198/push
# De quoi faire répondre les deux fichiers qui lient le site aux apps.
NUXT_APPLE_APP_ID=ABCDE12345.fr.babynamed.app
NUXT_ANDROID_EMPREINTES=14:6D:E9:83:C5:73:06:50:D8:EE:B9:95:2F:34:FC:64:16:A0:83:42:E6:1D:BE:A8:8A:04:96:B2:3F:CF:44:E5,nimportequoi
# Le compte de démonstration demandé par les stores.
NUXT_DEMO_EMAIL=demo@exemple.test
NUXT_DEMO_CODE=424242
# Un faux Stripe (le même que essai-caisse) : le témoin — un navigateur arrive
# à la caisse, une app non.
NUXT_STRIPE_SECRET_KEY=sk_test_essai_local
NUXT_STRIPE_PRICE_ID=price_essai_local
NUXT_STRIPE_WEBHOOK_SECRET=whsec_essai_local
NUXT_STRIPE_API_BASE=http://127.0.0.1:3199/v1
