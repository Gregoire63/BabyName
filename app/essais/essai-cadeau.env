# Un faux Stripe, sur la machine, pour essai-cadeau.mjs (le même que essai-caisse).
# Aucune de ces valeurs n'ouvre quoi que ce soit : elles n'existent pas chez Stripe.
NUXT_STRIPE_SECRET_KEY=sk_test_essai_local
NUXT_STRIPE_PRICE_ID=price_essai_local
NUXT_STRIPE_WEBHOOK_SECRET=whsec_essai_local
NUXT_STRIPE_API_BASE=http://127.0.0.1:3199/v1
# Le produit à part des cadeaux : c'est lui que la session doit porter.
NUXT_STRIPE_PRICE_ID_CADEAU=price_essai_cadeau
